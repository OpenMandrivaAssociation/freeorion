+// Python 3.15 removed Py_GetProgramFullPath, Py_GetPrefix and Py_GetPath.
+static void LogPythonConfig()
+{
+    auto log_text = [](const char* label, PyObject* value) {
+        const char* utf8 = (value && PyUnicode_Check(value)) ? PyUnicode_AsUTF8(value) : nullptr;
+        DebugLogger() << label << (utf8 ? utf8 : "<unavailable>");
+        if (!value)
+            PyErr_Clear();
+        Py_XDECREF(value);
+    };
+
+    log_text("Python program: ", PyConfig_Get("executable"));
+    log_text("Python prefix: ", PyConfig_Get("prefix"));
+
+    PyObject* paths = PyConfig_Get("module_search_paths");
+    if (!paths) {
+        PyErr_Clear();
+        DebugLogger() << "Python module search path: <unavailable>";
+        return;
+    }
+    if (PyList_Check(paths)) {
+        std::string joined;
+        const Py_ssize_t n = PyList_Size(paths);
+        for (Py_ssize_t i = 0; i < n; ++i) {
+            if (i)
+                joined.push_back(':');
+            PyObject* item = PyList_GetItem(paths, i);
+            const char* utf8 = (item && PyUnicode_Check(item)) ? PyUnicode_AsUTF8(item) : nullptr;
+            if (utf8)
+                joined += utf8;
+        }
+        DebugLogger() << "Python module search path: " << joined;
+    } else {
+        log_text("Python module search path: ", paths);
+        return;
+    }
+    Py_DECREF(paths);
+}
+
 PythonCommon::~PythonCommon()
 { Finalize(); }
 
